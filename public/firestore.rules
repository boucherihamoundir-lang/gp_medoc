rules_version = '2';

// MediDoc Pro - Cloud Firestore Security Rules
// Mode ouvert pour développement et mise en service directe des collections
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Profils Utilisateurs (Médecins & Patients)
    match /users/{userId} {
      allow read, write: if true;
    }

    // 2. Conversations & Sous-collection Messages
    match /chats/{chatId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // 3. Rendez-vous Médicaux
    match /appointments/{appointmentId} {
      allow read, write: if true;
    }
  }
}
